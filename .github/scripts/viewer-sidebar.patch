 }
+
+/* Edit/Replace swaps the inspector content, never adds a third column. */
+#image-lightbox.is-viewer-editing>#image-lightbox-close{display:none!important}
+#image-lightbox.is-viewer-editing .image-detail-inspector>:not(.viewer-editor-sidebar){display:none!important}
