{
  "expo": {
    "name": "Parallel Vision",
    "slug": "parallel-vision",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "parallelvision",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parallelvision.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Parallel Vision uses the microphone when you choose to speak with Nina FOK live.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.parallelvision.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e37457fc-64ac-4be7-b1ff-8681aa45fbc3"
      }
    }
  }
}
